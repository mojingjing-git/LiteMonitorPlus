{
  "version": 5,
  "name": "Cosmic Aurora Nebula GPU",
  "rendering": {
    "version": 1,
    "backend": "gpu",
    "material": "liquid_glass",
    "parameters": {
      "liveBackground": false,
      "cornerRadius": 18,
      "thickness": 1.2,
      "refraction": 1.5,
      "blurRadius": 12,
      "clearCenterRatio": 0.10,
      "surfaceOpacity": 0.07,
      "highlight": 0.95,
      "counterHighlight": 0.85,
      "shadow": 0.38
    },
    "motion": {
      "targetFps": 30,
      "stateTransitionMs": 180,
      "motionEnabled": true
    },
    "fallback": {
      "backend": "legacy",
      "material": "legacy"
    },
    "fallbackStyle": {
      "background": "#070A18",
      "panelBackground": "#121836",
      "border": "#5EE2FF",
      "text": "#F3F6FD",
      "mutedText": "#9CAFD8",
      "accent": "#00FFA3"
    }
  },
  "layout": {
    "rowHeight": 40,
    "padding": 10,
    "cornerRadius": 18,
    "groupRadius": 10,
    "groupPadding": 8,
    "groupSpacing": 28,
    "groupBottom": 0,
    "groupTitleOffset": 6,
    "itemGap": 6,
    "frameStyle": 0,
    "frameWidth": 0,
    "frameLength": 0,
    "scanline": 0,
    "glow": 0,
    "grid": 0,
    "barStyle": 1
  },
  "font": {
    "family": "Segoe UI Variable",
    "valueFamily": "Cascadia Code",
    "title": 11.5,
    "group": 10.5,
    "item": 10.0,
    "value": 14.0,
    "bold": true,
    "scale": 1.0
  },
  "color": {
    "background": "#070A18",
    "groupBackground": "rgba(18,24,54,0.14)",
    "border": "#5EE2FF",
    "shadow": "rgba(94,226,255,0.25)",
    "textTitle": "#F3F6FD",
    "textGroup": "#9CAFD8",
    "textPrimary": "#F3F6FD",
    "textSecondary": "#9CAFD8",
    "valueSafe": "#00FFA3",
    "valueWarn": "#FFAE57",
    "valueCrit": "#FF3388",
    "barBackground": "#16203D",
    "barLow": "#00FFA3",
    "barMid": "#FFAE57",
    "barHigh": "#FF3388"
  },
  "backdrop": {
    "mode": "gradient",
    "opacity": 0.08,
    "blur": 0,
    "tint": "rgba(94,226,255,0.10)",
    "gradientStart": "#121836",
    "gradientEnd": "#070A18",
    "gradientAngle": 90,
    "fps": 2
  }
}
