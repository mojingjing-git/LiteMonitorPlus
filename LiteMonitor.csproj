<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>resources\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      ★ DPI 感知等级 = Per-Monitor-V2（2026-10-21 用户拍板，见 docs/superpowers/plans/2026-10-20-appearance-a15-acceptance.md §6）。

      为什么要改：
      1. 液态玻璃的抓屏路线（屏幕捕获 + WDA_EXCLUDEFROMCAPTURE）要求进程能拿到**物理像素**坐标；
         A06 验证该路线用的探针（tests/AppearanceBackdropProbe）写的就是 PerMonitorV2，
         捕获引擎的前置守卫也只接受 PerMonitor / PerMonitorV2。
      2. 改动前主工程实际是 SystemAware(1)：csproj 无本属性、app.manifest 的 dpiAware 段被注释、
         Program.Main 走 ApplicationConfiguration.Initialize() 的默认值。
         ⇒ 玻璃在生产环境**一帧也抓不到**，只能降级为渐变/纯色。
      3. Per-Monitor-V2 还顺带修正了高 DPI 屏上"被系统整体拉伸、偏糊"的既有观感：
         窗口改为按目标屏 DPI 重新渲染。

      生效方式：WinForms SDK 生成的 ApplicationConfiguration.Initialize() 会在**创建任何窗口之前**
      调用 Application.SetHighDpiMode(PerMonitorV2)。src/System/Program.cs 的
      ApplicationConfiguration.Initialize() 位于 Application.Run(new MainForm()) 之前，满足该前提。

      ⚠️ 不要在 app.manifest 里启用旧的 <dpiAware>true</dpiAware>：manifest 的声明**优先于**运行期
      SetHighDpiMode，一旦启用就会把感知等级压回"系统感知"，玻璃又会失效。app.manifest 已加注说明。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	  
    <AssemblyName>LiteMonitor++</AssemblyName>
    <RootNamespace>LiteMonitor</RootNamespace><!-- 保持不变：Resources.Designer.cs 的资源名前缀依赖它 -->
    <Product>LiteMonitor++</Product>
    <Company>mojingjing-git</Company>
    <Copyright>Copyright © 2026 mojingjing-git. Based on LiteMonitor by Diorser (MIT).</Copyright>
    <Description>LiteMonitor++ — 轻量级桌面硬件监控工具，基于 LiteMonitor 派生</Description>
    <Version>1.0.0</Version><!-- 程序主版本（UpdateChecker / About用） -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion><!-- 稳定不动 -->
    <FileVersion>1.0.0.0</FileVersion><!-- 文件属性显示 -->
  </PropertyGroup>

  <!--
    ★ Phase 5 · 强类型编译门禁（仅 Release）。

    语义：Release 构建下，本工程内的**任何**编译警告一律升级为**错误**，
    使「可空引用治理」从一次性清理变成**持续可验证的工程不变量**。

    为何只限 Release：
      · Debug 保留警告可读性，便于开发期定位；
      · CI 的「门禁 1（生产零警告）」以 -c Release 执行，故门禁实际生效。

    为何写在**本 csproj** 而不是根级 Directory.Build.props：
      根级 props 会被 tests/ 与 tools/ 隐式导入，那里仍有 627 条真实可空债务
      与 42 条 xUnit 分析器规则警告（分属独立 Phase 6 / Phase 7），
      一并提升为错误会让门禁永久红灯。详见
      docs/plans/2026-10-26-nullable-warnings-remediation-plan.md §5.6。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>


	<ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- System.Text.Json 10.0.3：被强制的 Microsoft.Diagnostics.Tracing.TraceEvent 4.0.0 依赖（>= 10.0.3）拉高，
         否则还原期 NU1605（包降级）直接失败。产品侧用法（Serialize/Deserialize/JsonDocument）不受影响。 -->
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <!-- B1/C1：契约工程源码不得再被主工程递归 Compile 通配收编（同类型双编译），
       只经下方 ProjectReference 引用（Plan B §3、派发单 P-B1B2）。
       P-I2 同理：src/HardwareHost 的源码也必须从主 WinExe 的直接编译范围排除
       （否则主工程双入口 CS0017）；Host 产物经 CopyHardwareHostToOutput 进入主输出目录，
       主程序不引用 Host 程序集、也不把它当依赖启动（Plan A §7）。 -->
  <ItemGroup>
    <Compile Remove="src\Contracts\**\*.cs" />
    <Compile Remove="src\HardwareHost\**\*.cs" />
    <!-- ★ src\Cli 是独立控制台工程（LiteMonitor.Cli），有自己 Main ⇒ 必须排除，否则 CS0017 多入口点 -->
    <Compile Remove="src\Cli\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\Contracts\LiteMonitor.Contracts.csproj" />
    <!-- ReferenceOutputAssembly=false：只取构建顺序，不引用 Host 程序集。 -->
    <ProjectReference Include="src\HardwareHost\LiteMonitor.HardwareHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- P-I2：Host 产物复制进主输出目录（I2 只保证 Debug 输出可运行；发布打包属 I5）。
       仅复制 LiteMonitor.HardwareHost.*（exe/dll/deps.json/runtimeconfig.json），
       LHM 与 Contracts 依赖由主输出目录内同名同版本程序集满足。
       BaseOutputPath 会在 ProjectReference 间流动（如 perf-baseline.ps1 的 bin/perf-run/），
       Host 实际产物目录 = src/HardwareHost/$(BaseOutputPath)$(Configuration)，须与主输出同基。 -->
  <Target Name="CopyHardwareHostToOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <HardwareHostBinDir>$(MSBuildThisFileDirectory)src\HardwareHost\$(BaseOutputPath)$(Configuration)\net8.0-windows\</HardwareHostBinDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(HardwareHostBinDir)')">
      <HardwareHostOutputs Include="$(HardwareHostBinDir)LiteMonitor.HardwareHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(HardwareHostOutputs)"
          DestinationFiles="@(HardwareHostOutputs->'$(OutDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

    <!-- 自动复制 themes 与 lang 目录下的所有文件 -->
    <ItemGroup>
        <Content Include="resources\themes\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\lang\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\plugins\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\shaders\*.cso">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>

        <!-- 离线城市库（随包分发，避免运行时依赖远程服务） -->
        <Content Include="resources\assets\CityCode.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
	<ItemGroup>
		<Content Include="resources\LiteMonitor++.Updater.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
    <Content Include="使用说明(必读).txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	
	
<ItemGroup>
  <Compile Remove="LiteMonitor.Updater\**" />
  <Compile Remove="tests\**" />
  <Compile Remove="tools\**" />
  <Compile Remove="docs\**" />
  <!--
    ★ 本地工作区排除（与上面的既有排除同族）★
    SDK 项目的 Compile 默认通配是 **/*.cs，而 Compile Remove 只排除了
    LiteMonitor.Updater / tests / tools / docs。
    但本地存在 10+ 个 git worktree 的**全量副本**（.artifacts\ 与 .worktrees\），
    复审暂存目录 .review-scratch\ 里也有 target-src 全量副本。
    ★ .gitignore / .git/info/exclude 只影响 git，**不影响 MSBuild 通配** ⇒
      副本里的 src\System\Program.cs、tools\*Probe\Program.cs 全被编译进来，
      报 CS0017「程序定义了多个入口点」（本地可稳定复现）。
    ★ .artifacts\ 与 .worktrees\ 由 .git/info/exclude 排除、不入库
      ⇒ CI 全新 checkout 不含这些目录 ⇒ 这几条对 CI 是 no-op。
  -->
  <Compile Remove=".artifacts\**" />
  <Compile Remove=".worktrees\**" />
  <Compile Remove=".review-scratch\**" />
  <Compile Remove="undefined\**" />
  <EmbeddedResource Remove="LiteMonitor.Updater\**" />
  <EmbeddedResource Remove="tests\**" />
  <EmbeddedResource Remove="tools\**" />
  <EmbeddedResource Remove="docs\**" />
  <EmbeddedResource Remove="src\Cli\**" />
  <None Remove="LiteMonitor.Updater\**" />
  <None Remove="tests\**" />
  <None Remove="tools\**" />
  <None Remove="docs\**" />
</ItemGroup>
	
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\UI\Settings\" />
  </ItemGroup>

  <!--
    内部测试钩子的可见性出口。
    · LiteMonitor.Tests          —— 单元测试工程（ThemeFileService 的故障注入钩子）
    · AppearanceWindowShapeProbe —— 窗口轮廓自证探针（DWM 调用拦截接缝）
    这些成员在生产代码里收为 internal，避免扩大对外公开面。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="LiteMonitor.Tests" />
    <InternalsVisibleTo Include="LiteMonitor.GpuNonperformance.Tests" />
    <InternalsVisibleTo Include="AppearanceWindowShapeProbe" />
    <!-- B3：Instance 降 internal 后，主窗生命周期探针同样需要可见（与其他测试工程同待遇） -->
    <InternalsVisibleTo Include="GpuHostLifecycleProbe" />
    <!-- 主题工作室验收探针（tools/ThemeStudioAuditProbe）：需要 SettingsHelper.PathOverride、
         ThemeDocumentStore.SetThemeDirForTests/SetRecoveryDirForTests、SettingsThemeManager.Initialize
         等 internal 测试接缝，才能复现 N00–N10 验收报告的 10 条观测点。 -->
    <InternalsVisibleTo Include="ThemeStudioAuditProbe" />
    <!-- [S03] 卸载强杀子进程探针（tools/MarketUninstallCrashProbe）：
         独立进程注入 MarketInstallCrashException 后退出，需要 internal 卸载核心。 -->
    <InternalsVisibleTo Include="MarketUninstallCrashProbe" />
  </ItemGroup>
</Project>
