# 构建产物
bin/
obj/
*.user
*.suo

# 运行期数据（不应进版本库）
settings.json
settings.json.bak
HardwareHistory.json
HardwareHistory.json.bak
TrafficHistory.json
TrafficHistory.json.bak
*.log

# 评审/临时产物
.review-scratch/

# 性能探针的隔离输出目录（运行期产物：流量历史、硬件错误日志等，不进版本库）
tests/LiteMonitor.PerformanceProbe/output/

# 发布产物（由 scripts/pack-release.ps1 生成）
dist/

# 外观改造各探针/校验工程的隔离输出目录（构建产物 + 运行期证据，不进版本库）
# 这些目录可由探针工程重新生成；各包的结论数据已写入 docs/superpowers/plans/ 下的结果文档。
tests/Appearance*/output/
