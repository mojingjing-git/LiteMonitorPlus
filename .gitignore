# Build and IDE artifacts
bin/
obj/
*.user
*.suo

# Runtime state
settings.json
settings.json.bak
HardwareHistory.json
HardwareHistory.json.bak
TrafficHistory.json
TrafficHistory.json.bak
*.log

# Local review and development artifacts
/.review-scratch/

# UI automation helper output: elevated-automation scripts plus ~40MB of
# screenshot captures used for manual DPI/layout measurement. Machine-local
# working material only; the reusable DPI probe is kept under
# docs/development/measure-dpi.ps1 instead.
/.cua-helper/

# Local parallel-development worktrees (owner/verifier flow).
# These hold full repo copies; they must never be committed.
/.artifacts/
/.worktrees/

# Stray paths produced by unexpanded environment variables.
# %SystemDrive% is a literal directory name created when a path was not expanded;
# undefined/ is the same class of residue from an unexpanded %TEMP%.
/%SystemDrive%/
/undefined/
/.zcode/

# CI artifacts
/ci-artifacts/

# Scratch root for throwaway notes and NuGet scratch directories.
# Files here are working material (analysis drafts, restore scratch); they are
# never deliverables and must not be committed.
/.tmp/

# Probe build and runtime output
tests/**/output/
tests/**/Capture/

# Test run artifacts
TestResults/
*.trx

# Release output
/dist/

# Signing secrets
/secrets/
*.pkcs8
*.pfx

# Local update archives
LiteMonitor-old-config-*.zip
update.zip
update.zip.backup

# Local NuGet / .NET CLI caches.
# Produced when NUGET_PACKAGES / DOTNET_CLI_HOME are redirected into the repo root
# during an offline restore; the caches are machine-local and must never be committed.
/.nuget-packages/
/.dotnet-cli-home/
/NuGet/
restore.binlog
*.binlog

# Agent session scratch (sub-agent worktrees/notes live under .agents/)
/.agents/

# 探针运行输出（截图/诊断 JSON）
tools/ThemeSwitchReproProbe/output/

# 探针与取证产生的证据目录（不入库）
/.evidence/
