<Project Sdk="Microsoft.NET.Sdk">

  <!--
    W3「设置页意外回写」缺陷包的防回退探针。

    覆盖两组门槛：
      · 运行时 —— 回写抑制作用域的语义；SettingsUIBuilder 的立即绑定在抑制作用域内
        确实**不**回写（而作用域外确实回写，证明通道是通的而不是根本没挂上）；
        RegisterRefresh 刷新体在原值不在候选里时不会把原值冲掉。
      · 源码级 —— 8 个 Add* 的抑制守卫、3 个刷新体的作用域包裹、MonitorPage 的
        _linkHorizontalEdited 三元、SystemHardwarPage 的 6 个 AddComboPair 与两处 Fill* 包裹。

    设计约束（与 tests/AppearanceM2Probe 保持一致）：
    - 不新增任何 NuGet 包 / 测试框架 / 运行时依赖，只引用主项目与 BCL。
    - **不进 sln**（与既有探针的惯例一致）。
    - 输出目录固定为本项目下的 output\ ，即 AppContext.BaseDirectory；
      证据 JSON 落在 output\evidence\ 下，不污染用户常用实例目录。
    - 主项目已有 <Compile Remove="tests\**" />，本项目不会被主工程编译进去。
    - 本探针只构造内存中的 WinForms 控件与读取源码文本：不创建 HardwareMonitor、
      不 Open 硬件、不做屏幕捕获、不读也不写用户配置目录。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiteMonitor.AppearanceSettingsProbe</RootNamespace>
    <AssemblyName>AppearanceSettingsProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 隔离输出目录：探针自己的运行期产物目录（相对本项目目录） -->
    <OutputPath>output\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- 探针自身不追求零警告 -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteMonitor.csproj" />
  </ItemGroup>

</Project>
