<Project Sdk="Microsoft.NET.Sdk">

  <!--
    临时预览工具（UI 视觉美化轮）：离屏渲染任意主题为 PNG，用于快速自查视觉效果。
    - 与 AppearanceWiringProbe 同款约束：不进 sln、不新增 NuGet 依赖、不碰硬件、不做屏幕捕获。
    - 用后可删，不随发布物分发。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PreviewShot</RootNamespace>
    <AssemblyName>PreviewShot</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <OutputPath>output\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteMonitor.csproj" />
  </ItemGroup>

</Project>
