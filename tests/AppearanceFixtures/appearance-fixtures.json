      "clearAllItems": true
    },
    {
      "id": "edge-narrow-window",
      "kind": "narrowWindow",
      "panelWidth": 160,
      "description": "窄窗（160 逻辑像素）：验证窄宽度下的两列组与数值精简路径。"
    }
