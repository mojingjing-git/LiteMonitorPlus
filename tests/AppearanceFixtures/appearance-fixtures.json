{
  "kind": "appearance_fixture_data",
  "version": 1,
  "description": "LiteMonitor++ 外观探针 (A04) 的固定夹具数据。纯数据：不依赖硬件、不依赖驱动、不读用户配置。所有指标值由 valueModel 推导，Dashboard 文本由 dashValues 注入，保证同一台机器上可逐像素复现。",

  "axes": {
    "modes": ["vertical", "horizontal"],
    "gpuCounts": [1, 4],
    "dpis": [96, 120, 144, 192],
    "userScales": [1.0, 2.0],
    "panelWidth": 240,
    "referenceDpi": 96,
    "referenceUserScale": 1.0
  },

  "valueModel": {
    "base": 40.0,
    "step": 0.37,
    "max": 99.0,
    "itemOffset": 13.7,
    "note": "第 frame 帧、第 i 个指标的值 = base + ((i * itemOffset + frame * step) mod (max - base))"
  },

  "dashValues": {
    "HOST": "LITEBENCH-HOST",
    "Time": "Mon 00:00:00",
    "Uptime": "12h 34m",
    "IP": "192.168.1.42"
  },

  "requiredLegacyThemes": [
    "AuroraDream_Purple",
    "CyberBlue_Neon",
    "DarkFlat_Classic",
