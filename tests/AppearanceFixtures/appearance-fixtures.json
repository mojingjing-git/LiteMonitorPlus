    },
    {
      "id": "edge-custom-labels",
      "kind": "customLabels",
      "description": "用户自定义标签 / 短标签（含空格隐藏标签、含中文、含超长 ASCII）：验证标签优先级链。",
      "userLabels": {
        "CPU.Load": "处理器总占用率",
        "CPU.Temp": "封装温度 (Package)",
        "MEM.Load": "Physical Memory Occupancy Ratio",
        "GPU.0.Load": "图形处理器负载"
