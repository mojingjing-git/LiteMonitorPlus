  "invalidation": {
    "frames": 100,
    "fixedRect": { "x": 37, "y": 43, "width": 20, "height": 20 },
    "clipInflation": 3,
    "note": "clipInflation 用于把字形抗锯齿溢出一起纳入失效区；fixedRect 是 v4 §7.2 点名的固定失效矩形。"
  }
