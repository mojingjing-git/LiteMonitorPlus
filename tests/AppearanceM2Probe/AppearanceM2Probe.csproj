<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LiteMonitor++ M2 合同「源码级门槛」自证探针。

    覆盖 M2 合同 §9（docs/superpowers/plans/2026-10-20-appearance-m2-contract.md）中
    两条**与捕获后端实现完全无关**的门槛：
      · 门槛 #7 —— 绘制路径无捕获调用（源码扫描，剔除注释后匹配抓屏 API）
      · 门槛 #10 —— 无新增 NuGet 依赖（*.csproj 扫描）

    设计约束（与 tests/AppearanceWiringProbe 保持一致）：
    - 不新增任何 NuGet 包 / 测试框架 / 运行时依赖，只引用主项目与 BCL。
    - **不进 sln**（与既有探针的惯例一致）。
    - 输出目录固定为本项目下的 output\ ，即 AppContext.BaseDirectory；
      证据 JSON 落在 output\evidence\ 下，不污染用户常用实例目录。
    - 主项目已有 <Compile Remove="tests\**" />，本项目不会被主项目编译进去。
    - 本探针只读取源码文本与 csproj 文本：不创建 HardwareMonitor、不 Open 硬件、
      不做任何屏幕捕获、不读也不写用户配置目录。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiteMonitor.AppearanceM2Probe</RootNamespace>
    <AssemblyName>AppearanceM2Probe</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 隔离输出目录：探针自己的运行期产物目录（相对本项目目录） -->
    <OutputPath>output\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- 探针自身不追求零警告 -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteMonitor.csproj" />
  </ItemGroup>

</Project>
