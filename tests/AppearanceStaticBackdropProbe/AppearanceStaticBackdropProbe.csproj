<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A08 静态背景与降级的独立自证工程（AppearanceStaticBackdropProbe）。

    设计约束：
    - 不新增任何 NuGet 包 / 测试框架 / 运行时依赖；只引用主工程。
    - 输出目录固定为本项目下的 output\ ，即 AppContext.BaseDirectory。
    - 主项目已有 <Compile Remove="tests\**" />，本工程不会被主项目编译进去。
    - 本工程尚未加入 LiteMonitor.sln（sln 归主集成者），请主集成者接入。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LiteMonitor.AppearanceStaticBackdropProbe</RootNamespace>
    <AssemblyName>AppearanceStaticBackdropProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 隔离输出目录：探针自己的运行期产物目录（相对本项目目录） -->
    <OutputPath>output\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- 探针自身不追求零警告，但也不要用警告噪声干扰主项目构建 -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteMonitor.csproj" />
  </ItemGroup>

</Project>
