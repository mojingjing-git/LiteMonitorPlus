<Project Sdk="Microsoft.NET.Sdk">

  <!--
    候选 B（含 PR #2539 NVML 句柄生命周期修复的已发布预发布包）：
      LibreHardwareMonitorLib 0.9.7-pre767
      → 传递依赖 DiskInfoToolkit 2.2.1（库自带 RescanLoop/MediaWatchLoop，异常在库内被吞掉，可 StopMonitoring）
      → NvidiaGpu 每轮按 PCI 身份重取 NVML 句柄（NvidiaML.SyncRoot 锁 + GetNvmlDevice）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Probe.Fixed</AssemblyName>
    <RootNamespace>F09a.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Probe.Shared\ProbeRunner.cs" Link="ProbeRunner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre767" />
  </ItemGroup>

</Project>
