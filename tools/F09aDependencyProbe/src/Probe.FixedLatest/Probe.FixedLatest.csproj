<Project Sdk="Microsoft.NET.Sdk">

  <!--
    候选 C（当前可得的最新预发布包）：
      LibreHardwareMonitorLib 0.9.7-pre771
      → 传递依赖 DiskInfoToolkit 2.2.2 / RAMSPDToolkit-NDD 1.6.4
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Probe.FixedLatest</AssemblyName>
    <RootNamespace>F09a.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Probe.Shared\ProbeRunner.cs" Link="ProbeRunner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre771" />
  </ItemGroup>

</Project>
