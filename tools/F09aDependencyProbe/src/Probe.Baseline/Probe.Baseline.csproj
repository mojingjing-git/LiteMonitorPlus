<Project Sdk="Microsoft.NET.Sdk">

  <!--
    候选 A（当前生产依赖基线）：LibreHardwareMonitorLib 0.9.6
    → 传递依赖 DiskInfoToolkit 1.1.2（库自带 DevicesChangedListener 线程，无异常边界）
    → NvidiaGpu 缓存 readonly _nvmlDevice 字段（无句柄重取）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Probe.Baseline</AssemblyName>
    <RootNamespace>F09a.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Probe.Shared\ProbeRunner.cs" Link="ProbeRunner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
