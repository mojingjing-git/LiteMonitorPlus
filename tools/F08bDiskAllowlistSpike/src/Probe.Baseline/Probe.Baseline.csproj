<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P-F08b Spike —— 变体 Baseline：当前生产依赖基线 LibreHardwareMonitorLib 0.9.6
    （传递依赖 DiskInfoToolkit 1.1.2）

    目的：**决策门**。判定"能否在库创建磁盘设备对象与打开句柄之前，把不在允许列表内的磁盘排除掉"。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Spike.Baseline</AssemblyName>
    <RootNamespace>F08b.Spike</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Probe.Shared\SpikeRunner.cs" Link="SpikeRunner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
