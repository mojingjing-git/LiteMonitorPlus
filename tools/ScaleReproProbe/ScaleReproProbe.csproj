<Project Sdk="Microsoft.NET.Sdk">
  <!--
    缩放复现探针（UI 缩放 Bug 取证）：
    在真实 MainForm + GPU 路线下依次切换用户缩放（UIScale），
    每次切换后截图并导出 GPU 交换链尺寸 / 窗体客户区尺寸对照表。
    与 GpuUiProbe 同款约束：不进 sln、只跑本机、不抓真实硬件。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ScaleReproProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resources\themes\*.json"
             Link="resources\themes\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\shaders\*.cso"
             Link="resources\shaders\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\lang\*.json"
             Link="resources\lang\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\plugins\*.json"
             Link="resources\plugins\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\assets\CityCode.json"
             Link="resources\assets\CityCode.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
