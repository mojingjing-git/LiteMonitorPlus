# ============================================================
# 统一换行与二进制声明
# ============================================================
# ★ 为什么需要本文件：
#   此前仓库没有 .gitattributes，文本文件的换行完全依赖使用者的本地
#   core.autocrlf 设置。后果：
#     · 同一份代码在不同机器上工作区换行不一致（当前仓库 558 个 CRLF
#       对 78 个 LF，另有 1 个 mixed）；
#     · 一次性脚本（如 scripts/add-rendering-route-i18n.py）用
#       newline=None 读、newline="" 写，会把整个文件的换行改写，
#       造成与全仓不一致的工作区基线；
#     · "这个文件到底该是什么换行"没有仓库级真相源。
#   下面把规则固化到仓库里：文本一律以 **LF 入库**、**CRLF 落工作区**
#   （Windows 开发环境默认），二进制一律禁止转换。
#
# ★ 生效前提：索引中已全部是 LF（`git ls-files --eol` 无 i/crlf 项），
#   因此本文件**不会**触发任何重新规范化改动（`git add --renormalize`
#   产生空 diff）。改完执行一次 checkout 即可让工作区换行收敛。
# ============================================================

# ---- 文本：入库 LF，工作区 CRLF ----
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.json      text eol=crlf
*.md        text eol=crlf
*.txt       text eol=crlf
*.ps1       text eol=crlf
*.py        text eol=crlf
*.yml       text eol=crlf
*.yaml      text eol=crlf
*.hlsl      text eol=crlf
*.hlsli     text eol=crlf
*.xml       text eol=crlf
*.config    text eol=crlf
*.resx      text eol=crlf
*.manifest  text eol=crlf

# ---- 例外：契约夹具必须逐字节可复现 ----
#   tests/fixtures/plugin-repo/ 的 index.json 里记录了各插件清单的 sha256 与
#   size，MarketIndexContractTests 直接对**工作区原始字节**求哈希。
#   若这里按上面的 *.json 落成 CRLF，字节口径与 index.json 对不上 ⇒ 测试必红。
#   该目录自带的 .gitattributes 已声明 eol=lf（子目录规则优先），此处再显式
#   声明一次，避免读者误以为根规则的 *.json 会覆盖它。
tests/fixtures/plugin-repo/** text eol=lf

#   主题市场夹具同理（M5）：theme-repo/index.json 记录了各主题 JSON 的 sha256
#   与 size，ThemeMarketContractTests 对工作区原始字节求哈希，必须逐字节可复现。
tests/fixtures/theme-repo/** text eol=lf

# ---- 二进制：禁止任何换行转换 ----
*.cso       binary
*.exe       binary
*.dll       binary
*.zip       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.db        binary

# ---- 特殊：CityCode.json 是**单行无换行符**的紧凑 JSON ----
#   它的 115,871 字节里 CR=0 / LF=0，Git 因此把它判为二进制
#   （`git ls-files --eol` 显示 i/none），导致 diff 完全不可读。
#   显式声明为 text，让它按 UTF-8 文本参与行级 diff。
resources/assets/CityCode.json text eol=crlf

# ---- 保留：文档内的示例 LF ----
*.bat       text eol=crlf
