<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Updater 应该是一个完全独立可执行程序 -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishTrimmed>false</PublishTrimmed>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- 改名以减少误报 -->
		<AssemblyName>LiteMonitor++.Updater</AssemblyName>
		<!-- 程序集元数据 (增加可信度) -->
		<Company>LiteMonitor</Company>
		<Product>LiteMonitor++ Auto Updater</Product>
		<Description>Automatic update component for the LiteMonitor++ system monitoring tool.</Description>
		<Copyright>Copyright © 2026 mojingjing-git</Copyright>
		<FileVersion>1.2.5.0</FileVersion>
		<AssemblyVersion>1.2.5.0</AssemblyVersion>

		<!-- 禁用顶级语句 -->
		<UseMaui>false</UseMaui>

		<!-- 指定 Main 入口 -->
		<StartupObject>LiteMonitor.Updater.Program</StartupObject>
	</PropertyGroup>

	<!--
		可空引用编译门禁（Phase 5）· 2026-10-26
		自动更新器随主程序一同发布，其可空债务与主程序同级，故与另外三个生产工程
		（LiteMonitor / HardwareHost / Contracts）采用同一口径：
		Release 构建下**任何编译警告一律升级为错误**。
		仅限 Release —— Debug 下保留警告可见性，避免本地调试被无关告警打断。
		详见 docs/plans/2026-10-26-nullable-warnings-remediation-plan.md §5.6。
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LiteMonitor.Updater.Tests" />
	</ItemGroup>
</Project>
