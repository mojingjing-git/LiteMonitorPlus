<Project Sdk="Microsoft.NET.Sdk">

  <!-- B1/C1 契约工程：net8.0、无 WinForms/LHM/Vortice 依赖（Plan B §3、Plan A §4）。
       主 WinExe 必须以 Compile Remove 排除本目录源码，经 ProjectReference 引用，
       避免同一类型编译进两个程序集。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LiteMonitor.Contracts</RootNamespace>
    <AssemblyName>LiteMonitor.Contracts</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    ★ 强类型编译门禁（仅 Release）。
    语义与理由见仓库根 LiteMonitor.csproj 的同名 PropertyGroup 注释；
    本工程是「门禁 1」的三个生产工程之一（零警告硬门禁）。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
